+ /*
+  * AN515-45 CoolBoost. Original NitroSense CommonFunction uses APGeAction
+  * GetFunction(0x207) and SetFunction(7 | enabled << 16).
+  * Keep firmware return status separate from ACPI transport success.
+  */
+ static ssize_t nitro_coolboost_show(struct device *dev,
+                                    struct device_attribute *attr, char *buf)
+ {
+     u64 result;
+     acpi_status status = WMI_apgeaction_execute_u64(
+         ACER_WMID_GET_FUNCTION, 0x207, &result);
+
+     if (ACPI_FAILURE(status) || (result & 0xff) != 0 ||
+         ((result >> 8) & 0xff) > 1)
+         return -EIO;
+     return sysfs_emit(buf, "%llu\n", (result >> 8) & 0xff);
+ }
+
+ static ssize_t nitro_coolboost_store(struct device *dev,
+                                     struct device_attribute *attr,
+                                     const char *buf, size_t count)
+ {
+     bool enabled;
+     u64 result;
+     acpi_status status;
+     int err = kstrtobool(buf, &enabled);
+
+     if (err)
+         return err;
+     status = WMI_apgeaction_execute_u64(ACER_WMID_SET_FUNCTION,
+                                        7ULL | ((u64)enabled << 16), &result);
+     if (ACPI_FAILURE(status) || (result & 0xff) != 0)
+         return -EIO;
+     return count;
+ }
+ static DEVICE_ATTR(coolboost, 0644, nitro_coolboost_show, nitro_coolboost_store);
